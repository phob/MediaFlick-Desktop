# Rust build outputs
/target/

# Local packaged/runtime build artifacts
/build/
/dist/
/release/

# UI bundle: built by build.rs, never committed, so a stale bundle can't ship
/ui/node_modules/
/ui/dist/

# Companion plugin build and NuGet restore outputs
/plugin/bin/
/plugin/**/bin/
/plugin/**/obj/

# Scratch/vendor checkouts
/tmp/
/.cache/

# Logs and diagnostics
/TestResults/
__pycache__/
*.pyc
*.log
*.pdb
*.d

# Environment and local configuration
.env
.env.*
!.env.example
*.local

# Editor/IDE files
.vscode/*
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# Background Rust diagnostics
.bacon-locations

# OS files
.DS_Store
Thumbs.db
Desktop.ini
